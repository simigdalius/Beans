# =====================================================================
# .env.example — Δείγμα ρυθμίσεων του backend
# ---------------------------------------------------------------------
# Αντιγράψτε αυτό το αρχείο ως .env (στον ίδιο φάκελο):
#   cp .env.example .env
#
# Το JWT_SECRET ΔΕΝ χρειάζεται να το αλλάξετε με το χέρι: την πρώτη φορά
# που θα ξεκινήσει ο server, θα δει ότι είναι το δείγμα και θα το
# αντικαταστήσει αυτόματα με ένα τυχαίο μέσα στο .env.
#
# Το .env ΔΕΝ ανεβαίνει ποτέ στο GitHub (το εμποδίζει το .gitignore),
# γιατί περιέχει μυστικά.
# =====================================================================

# Μυστικό κλειδί για την υπογραφή των tokens σύνδεσης (φτιάχνεται αυτόματα)
JWT_SECRET=βάλτε-εδώ-ένα-μεγάλο-τυχαίο-κείμενο

# Η θύρα στην οποία τρέχει ο server (http://localhost:3000)
PORT=3000
