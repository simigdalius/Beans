# =====================================================================
# .env.example — Δείγμα ρυθμίσεων του backend
# ---------------------------------------------------------------------
# 1. Αντιγράψτε αυτό το αρχείο ως .env (στον ίδιο φάκελο)
# 2. Βάλτε δικό σας JWT_SECRET. Δημιουργήστε ένα τυχαίο με την εντολή:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Το .env ΔΕΝ ανεβαίνει ποτέ στο GitHub (το εμποδίζει το .gitignore),
# γιατί περιέχει μυστικά.
# =====================================================================

# Μυστικό κλειδί για την υπογραφή των tokens σύνδεσης
JWT_SECRET=βάλτε-εδώ-ένα-μεγάλο-τυχαίο-κείμενο

# Η θύρα στην οποία τρέχει ο server (http://localhost:3000)
PORT=3000
